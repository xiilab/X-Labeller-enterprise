	<bean id="mailSender" class ="org.springframework.mail.javamail.JavaMailSenderImpl" >
	    <property name="host" value="smtp.gmail.com" />
	    <property name="port" value="587" />
		<property name="username" value="dev@xiilab.com" />
	    <property name="password" value="devxiirocks" />
	    <property name="defaultEncoding" value="utf-8" />
	    <property name="javaMailProperties">
	    <props>
	    	<prop key="mail.smtp.auth">true</prop>
	        <prop key="mail.smtp.starttls.enable">true</prop>
	    </props>
	    </property>
	</bean>
	
	
	
		
	<bean id="dayTask" class="com.xlabeller.quartz.DayTask"/>
	<bean id="quartzLock" class="com.xlabeller.quartz.QuartzLock"/>
 
    <bean name="dayJob" class="org.springframework.scheduling.quartz.JobDetailFactoryBean" p:jobClass="com.xlabeller.quartz.DayJob">
        <property name="jobDataAsMap">
            <map>
                <entry key="dayTask" value-ref="dayTask"/>
                <entry key="quartzLock" value-ref="quartzLock"/>
            </map>
        </property>
    </bean>
 
    <bean id="cronTrigger" class="org.springframework.scheduling.quartz.CronTriggerFactoryBean" p:jobDetail-ref="dayJob"
    		p:cronExpression="0/5 * * * * ?"/>
    		


 
    <bean id="schedulerFactoryBean" class="org.springframework.scheduling.quartz.SchedulerFactoryBean">
        <property name="triggers">
            <list>
                <ref bean="cronTrigger"/>
            </list>
        </property>
    </bean>
	
	
	
	
